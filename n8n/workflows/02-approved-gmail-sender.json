{
  "name": "7Key - Approved Gmail Sender",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "7key/send-approved",
        "responseMode": "lastNode"
      },
      "id": "w2webhook",
      "name": "Approved Send Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.body.approved}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{$json.body.email}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ifapproved",
      "name": "Approved & Has Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{$json.body.email}}",
        "subject": "={{$json.body.subject}}",
        "emailType": "text",
        "message": "={{$json.body.message}}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail1",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        520,
        -90
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_IN_N8N",
          "name": "7Key Gmail"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true,status:'sent',prospectId:$json.body?.id || $json.id || null} }}"
      },
      "id": "sentresponse",
      "name": "Return Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        790,
        -90
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:false,status:'blocked',reason:'Approval or email missing'} }}"
      },
      "id": "blockedresponse",
      "name": "Return Blocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        520,
        120
      ]
    }
  ],
  "connections": {
    "Approved Send Webhook": {
      "main": [
        [
          {
            "node": "Approved & Has Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved & Has Email": {
      "main": [
        [
          {
            "node": "Send Gmail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Gmail": {
      "main": [
        [
          {
            "node": "Return Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}