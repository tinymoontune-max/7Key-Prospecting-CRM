    {
      "parameters": {
        "jsCode": "const src=$('Prepare Enrichment').first().json; const raw=$input.first().json; let html=typeof raw==='string'?raw:(raw&&typeof raw.data==='string'?raw.data:JSON.stringify(raw||{})); const emails=[...new Set([...[...html.matchAll(/mailto:([^\\\"'?<>\\s]+)/gi)].map(m=>m[1]),...(html.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi)||[])])].filter(e=>!/example\\.|sentry\\.|wixpress\\.|cloudflare/i.test(e)); const links=[...html.matchAll(/href=[\\\"']([^\\\"']+)[\\\"']/gi)].map(m=>m[1]); const contact=links.find(h=>/contact|quote|estimate|get-in-touch/i.test(h))||''; let contactUrl=''; if(contact){try{contactUrl=new URL(contact,src.website_candidate).href}catch{}} return [{json:{...src,website_live:html.length>200,homepageEmail:emails[0]||'',homepageEmails:emails,contactUrl,homepageChecked:true}}];"
