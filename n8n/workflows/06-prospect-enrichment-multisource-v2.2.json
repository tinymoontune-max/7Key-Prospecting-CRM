    {
      "parameters": {
        "jsCode": "const p=$json; const norm=v=>String(v||'').trim().toLowerCase(); const officialEmail=p.contactPageEmail||p.homepageEmail||''; const osmEmail=p.email||''; const conflict=!!officialEmail&&!!osmEmail&&norm(officialEmail)!==norm(osmEmail); const chosen=officialEmail||osmEmail||''; const provenance=officialEmail?(p.contactPageEmail?'Official website contact page':'Official website homepage'):(osmEmail?'OpenStreetMap / existing prospect data':''); const evidence=[]; if(p.website_live)evidence.push('Official website reachable'); if(officialEmail)evidence.push('Email found on official website'); if(osmEmail)evidence.push('OSM/existing email present'); if(conflict)evidence.push(`Email conflict detected: official website=${officialEmail}; OSM/existing=${osmEmail}`); const confidence=officialEmail?90:(osmEmail?55:20); return [{json:{...p,email:chosen,email_source:provenance,official_email:officialEmail,osm_email:osmEmail,email_conflict:conflict,email_conflict_status:conflict?'Conflict detected':'No conflict',verification_status:conflict?'Needs verification':(officialEmail?'Verified':'Needs verification'),safe_to_outreach:!!officialEmail&&!conflict,confidence,evidence,provenance:{email:provenance},notes:conflict?'Official website email conflicts with OSM/existing email. Review before outreach.':(officialEmail?'Official website email has priority over OSM/existing data.':'No official website email found; do not auto-send using OSM email alone.')}}];"
